<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>pdf2word</AssemblyName>
    <RootNamespace>PdfToWord.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <OptimizationPreference>Speed</OptimizationPreference>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Extração de texto, glifos, fontes, imagens e caminhos vetoriais (Bounding Boxes) -->
    <PackageReference Include="PdfPig" Version="0.1.9" />

    <!-- SDK oficial da Microsoft para geração nativa de documentos Word (.docx) -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />

    <!-- Wrapper do Google PDFium para renderização matricial de alta fidelidade (300+ DPI) -->
    <PackageReference Include="PDFiumCore" Version="133.0.6844" />

    <!-- Manipulação de buffers de imagem 2D e codificação PNG sem perdas (lossless) -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />

    <!-- Motor de OCR Open Source para fallback em páginas escaneadas -->
    <PackageReference Include="Tesseract" Version="5.2.0" />

    <!-- Interface CLI interativa, barras de progresso e tabelas de status -->
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.49.1" />
  </ItemGroup>

</Project>
